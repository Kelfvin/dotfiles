.DS_Store

# 未纳入仓库的敏感/平台配置目录
github-copilot/
raycast/
/.config/herdr-mirror/

# Pi 运行时数据（仅 .pi/agent/settings.json 纳入仓库）
/.pi/subagents/
/.pi/agent/sessions/
/.pi/agent/cache/

# 运行时生成的日志
btop.log
nvim.log
/.config/herdr/*.log

# Herdr 运行时状态
/.config/herdr/*.sock
/.config/herdr/session.json
/.config/herdr/.plugins.lock

# 备份/临时文件
*.bak
*.toml-*

# 运行时生成的数据目录（配置本体仍被追踪）
/.config/karabiner/automatic_backups
/.config/yazi/plugins/*
!/.config/yazi/plugins/smart-switch.yazi/
!/.config/yazi/plugins/smart-tab.yazi/
.tmux/plugins

# 本地私有文件
zsh/.claude
.zshrc.local
.config/fish/config.local.fish

# 资源文件，不在 README 引用，避免误提交大文件
assets/
/.config/zed/prompts/
