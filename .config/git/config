[user]
	name = kelf
	email = kelfvin@163.com

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    autoSetupRemote = true

# delta: git diff 语法高亮 pager（需安装 delta/git-delta）
[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    dark = true

[merge]
    conflictStyle = zdiff3
