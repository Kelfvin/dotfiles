#!/bin/sh

AGENT_LINK="$HOME/.ssh/agent.sock"

if [ -n "${SSH_AUTH_SOCK:-}" ] && [ -S "$SSH_AUTH_SOCK" ]; then
    # Keep the stable path used by long-lived tmux shells in sync with the
    # current forwarded agent.
    ln -sfn "$SSH_AUTH_SOCK" "$AGENT_LINK"
elif [ -L "$AGENT_LINK" ] && [ ! -S "$AGENT_LINK" ]; then
    # Do not leave a dead forwarded-agent path behind for later shells.
    rm -f "$AGENT_LINK"
fi
